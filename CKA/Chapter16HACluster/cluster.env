# =====================================================================
# cluster.env  -  ONE place for all names, IPs and versions.
# Every script in this folder reads this file. Edit here only.
# =====================================================================

# ---------- Kubernetes ----------
K8S_VERSION="1.35"                 # minor version to install
CALICO_VERSION="v3.29.3"
POD_CIDR="192.168.0.0/16"

# Stable API endpoint used by EVERY node and by kubectl:
#   k8s-api:6443  ->  HA VM (HAProxy)  ->  all 3 kube-apiservers :6443
# The HA VM is also the ADMIN box: you run kubectl / etcdctl / demos from it.
LB_NAME="vm-k8s-lb"
LB_IP="10.0.1.10"
API_ENDPOINT_NAME="k8s-api"
API_ENDPOINT_PORT="6443"

# ---------- Nodes  (name:private-ip) ----------
# The FIRST control plane is the one that runs 'kubeadm init'.
CP_NODES="vm-k8s-cp1:10.0.1.11 vm-k8s-cp2:10.0.1.12 vm-k8s-cp3:10.0.1.13"
WORKER_NODES="vm-k8s-worker1:10.0.1.21 vm-k8s-worker2:10.0.1.22 vm-k8s-worker3:10.0.1.23"

# Node added later in the demo via CLI (05-add-new-node.sh)
NEW_NODE_NAME="vm-k8s-worker4"
NEW_NODE_IP="10.0.1.24"

# ---------- Azure ----------
RG="rg-k8s-ha-demo"
LOCATION="centralindia"
VNET_NAME="vnet-k8s-ha"
VNET_CIDR="10.0.0.0/16"
SUBNET_NAME="snet-k8s"
SUBNET_CIDR="10.0.1.0/24"
NSG_NAME="nsg-k8s-ha"
VM_SIZE="Standard_B2s"             # 2 vCPU / 4 GB (min for control plane)
LB_VM_SIZE="Standard_B1ms"         # 1 vCPU / 2 GB is plenty for HAProxy + kubectl
VM_IMAGE="Ubuntu2204"
ADMIN_USER="azureuser"
SSH_SOURCE="*"                     # tighten to "<your-public-ip>/32" if you can
