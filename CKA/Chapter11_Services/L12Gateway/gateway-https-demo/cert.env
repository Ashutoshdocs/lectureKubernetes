# ---------------------------------------------------------------------------
# Settings for the certbot scripts in scripts/. Edit these, then run
#   ./scripts/issue-cert.sh
# ---------------------------------------------------------------------------

# Email Let's Encrypt uses for expiry warnings and account recovery.
CERT_EMAIL="you@example.com"

# Domains on the certificate, comma-separated. The first one names the cert.
# Every domain must be inside DNS_ZONE. Examples:
#   "akblazeacademy.net"
#   "akblazeacademy.net,www.akblazeacademy.net"
#   "akblazeacademy.net,*.akblazeacademy.net"     (wildcard works with DNS-01)
CERT_DOMAINS="akblazeacademy.net"

# Azure DNS zone and the resource group that holds it.
DNS_ZONE="akblazeacademy.net"
DNS_RG="akblaze-rg"

# Kubernetes namespace and Secret name the Gateway reads the certificate from.
# Must match manifests/10-gateway.yaml (tls.certificateRefs).
K8S_NAMESPACE="webapps"
K8S_SECRET="akblaze-tls"

# 1 = Let's Encrypt STAGING (untrusted test cert, generous rate limits).
# Start with 1, confirm everything works, then set 0 and re-run issue-cert.sh.
STAGING=1

# Optional: a different ACME server (another CA, or a local Pebble test server).
# When set, it overrides STAGING.
# ACME_SERVER="https://acme-v02.api.letsencrypt.org/directory"

# Optional: subscription that holds the DNS zone, if not your az default.
# AZ_SUBSCRIPTION=""

# Optional: kubectl context to load the Secret into, if not the current one.
# KUBE_CONTEXT=""
