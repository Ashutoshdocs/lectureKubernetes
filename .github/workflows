name: Execute kubectl Command on AKS

on:
  workflow_dispatch:
    inputs:
      kubectl_command:
        description: "Enter kubectl command to execute"
        required: true
        type: string

env:
  RESOURCE_GROUP: my-aks-rg
  AKS_CLUSTER: my-aks-cluster

jobs:

  deploy:
    runs-on: ubuntu-latest

    steps:

      # 1. Checkout repository
      - name: Checkout repository
        uses: actions/checkout@v4

      # 2. Login to Azure
      - name: Azure Login
        uses: azure/login@v2
        with:
          creds: ${{ secrets.AZURE_CREDENTIALS }}

      # 3. Connect to AKS
      - name: Set AKS Context
        uses: azure/aks-set-context@v4
        with:
          resource-group: ${{ env.RESOURCE_GROUP }}
          cluster-name: ${{ env.AKS_CLUSTER }}

      # 4. Setup kubectl
      - name: Setup kubectl
        uses: azure/setup-kubectl@v4

      # 5. Check AKS connection
      - name: Check AKS
        run: |
          kubectl get nodes

      # 6. Execute user's kubectl command
      - name: Execute kubectl command
        run: |
          echo "Executing:"
          echo "${{ inputs.kubectl_command }}"

          ${{ inputs.kubectl_command }}
