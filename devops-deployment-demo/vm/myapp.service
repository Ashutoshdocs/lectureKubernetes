[Unit]
Description=DevOps Demo Flask App
After=network.target

[Service]
Type=simple
User=myapp
Group=myapp
WorkingDirectory=/opt/myapp
Environment=DEPLOY_MODE=Bare-VM
Environment=APP_VERSION=1.0.0
Environment=GREETING=Hello from a plain VM (systemd)!
Environment=PORT=8080
# Run with gunicorn (production WSGI server), 2 workers
ExecStart=/opt/myapp/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:8080 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
