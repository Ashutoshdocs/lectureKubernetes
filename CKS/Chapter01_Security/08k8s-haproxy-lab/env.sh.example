# Copy to env.sh and fill in the values printed by 01-create-vms.sh
# Then:  source env.sh

# ---- PUBLIC IPs (used only for SSH from your laptop) ----
export HAPROXY_PUB=""
export C1CP_PUB=""
export C1WK_PUB=""
export C2CP_PUB=""
export C2WK_PUB=""
export CLUSTERWORK_PUB=""

# ---- PRIVATE IPs (used INSIDE the VNet for real traffic) ----
export HAPROXY_IP=""        # 10.0.1.x
export C1CP_IP=""           # 10.0.1.x  (API server 1)
export C1WK_IP=""           # 10.0.1.x
export C2CP_IP=""           # 10.0.1.x  (API server 2)
export C2WK_IP=""           # 10.0.1.x

# ---- Logins ----
export ADMIN_USER="azureuser"
